        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "siteparser:notifier_error_ratio:rate1m / 0.01",
          "legendFormat": "1m burn rate",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "siteparser:notifier_error_ratio:rate5m / 0.01",
