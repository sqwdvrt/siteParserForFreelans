        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "siteparser:notifier_error_ratio:rate6h / 0.01",
          "legendFormat": "6h burn rate",
          "refId": "D"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
