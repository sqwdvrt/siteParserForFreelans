global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/recording_rules.yml
  - /etc/prometheus/alerts.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager:9093

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - localhost:9090

  - job_name: backend-api
    metrics_path: /metrics
    scheme: __BACKEND_API_METRICS_SCHEME__
    __BACKEND_API_TLS_CONFIG_START__
    tls_config:
      insecure_skip_verify: __BACKEND_API_METRICS_TLS_INSECURE_SKIP_VERIFY__
    __BACKEND_API_TLS_CONFIG_END__
    static_configs:
      - targets:
          - __BACKEND_API_METRICS_TARGET__

  - job_name: backend-crawler
    metrics_path: /metrics
    static_configs:
      - targets:
          - backend-crawler:8081

  - job_name: backend-notifier
    metrics_path: /metrics
    static_configs:
      - targets:
          - backend-notifier:8082

  - job_name: ai-service
    metrics_path: /metrics
    static_configs:
      - targets:
          - ai-service:9108

  - job_name: ai-ac-consumer
    metrics_path: /metrics
    static_configs:
      - targets:
          - ai-ac-consumer:9109

  - job_name: ai-user-embed
    metrics_path: /metrics
    static_configs:
      - targets:
          - ai-user-embed:9110

  - job_name: ai-user-rematch
    metrics_path: /metrics
    static_configs:
      - targets:
          - ai-user-rematch:8092

  - job_name: telegram-bot
    metrics_path: /metrics
    static_configs:
      - targets:
          - telegram-bot:9107

  - job_name: browser-service
    metrics_path: /metrics
    static_configs:
      - targets:
          - browser-service:8090

  - job_name: redis-exporter
    static_configs:
      - targets:
          - redis-exporter:9121

  - job_name: postgres-exporter
    static_configs:
      - targets:
          - postgres-exporter:9187
