global:
  resolve_timeout: 5m

route:
  receiver: default
  group_by: ["alertname", "service", "severity"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 2h
  routes:
    - receiver: telegram
      matchers:
        - severity=~"warning|critical"
      continue: true
__SLACK_ROUTE_START__
    - receiver: slack
      matchers:
        - severity=~"warning|critical"
__SLACK_ROUTE_END__

receivers:
  - name: default
  - name: telegram
    telegram_configs:
      - bot_token: "__TELEGRAM_BOT_TOKEN__"
        chat_id: __TELEGRAM_CHAT_ID__
        send_resolved: true
        message: >-
          [{{ .Status | toUpper }}] {{ .CommonLabels.alertname }} ({{ .CommonLabels.severity }})
          {{ .CommonAnnotations.summary }}
__SLACK_RECEIVER_START__
  - name: slack
    slack_configs:
      - api_url: "__SLACK_WEBHOOK_URL__"
        channel: "#alerts"
        send_resolved: true
        title: "[{{ .Status | toUpper }}] {{ .CommonLabels.alertname }}"
        text: >-
          Service: {{ .CommonLabels.service }}
          Severity: {{ .CommonLabels.severity }}
          Summary: {{ .CommonAnnotations.summary }}
__SLACK_RECEIVER_END__
