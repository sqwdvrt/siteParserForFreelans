# App mode: development | production
APP_ENV=development

# PostgreSQL
POSTGRES_USER=site_parser
POSTGRES_PASSWORD=change_me_strong_postgres_password
POSTGRES_DB=site_parser
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_PORT=55432
# Local dev
DATABASE_URL=postgres://site_parser:change_me_strong_postgres_password@localhost:55432/site_parser?sslmode=disable
# Optional dedicated migration DSN; current project `.env` keeps it equal to DATABASE_URL.
DATABASE_MIGRATE_URL=postgres://site_parser:change_me_strong_postgres_password@localhost:55432/site_parser?sslmode=disable
# Postgres pool tuning used in the current project env.
PG_POOL_MAX_CONNS=10
PG_POOL_MIN_CONNS=1
PG_POOL_ACQUIRE_TIMEOUT=15s
# Production example (must be sslmode=require/verify-*):
# DATABASE_URL=postgres://site_parser:strong_password@db.example.com:5432/site_parser?sslmode=require

# Redis
# Local dev
REDIS_URL=redis://localhost:6379/0
# Production example (must be rediss:// + password):
# REDIS_URL=rediss://default:strong_redis_password@redis.example.com:6380/0
REDIS_BIND_IP=127.0.0.1
REDIS_PORT=6379
AI_QUEUE=ai-process
AI_PROCESS_POP_TIMEOUT_SEC=60

# Crawler
CRAWL_RATE_SEC=15
CRAWL_RETRY_MAX_ATTEMPTS=3
CRAWL_RETRY_BASE_BACKOFF=1s
CRAWL_RETRY_MAX_BACKOFF=30s
CRAWL_RUN_TIMEOUT=90m
# Global cron fallback (если для источника нет CRAWL_CRON_<SOURCE>)
CRAWL_CRON="0 5 * * *"
# Per-source cron schedules (переопределяют CRAWL_CRON для конкретного источника)
# Формат: стандартный cron (min hour dom month dow)
# Примеры:
#   CRAWL_CRON_KWORK="0 */4 * * *"        # каждые 4 часа
#   CRAWL_CRON_FLRU="0 6,18 * * *"        # 2 раза в день (утро/вечер)
#   CRAWL_CRON_TELEGRAM_CHANNELS="0 * * * *"  # каждый час
#   CRAWL_CRON_FREELANCEHUNT="0 8 * * *"  # раз в день утром
CRAWL_CRON_KWORK=""
CRAWL_CRON_FLRU=""
CRAWL_CRON_FREELANCEHUNT=""
CRAWL_CRON_WEBLANCER=""
CRAWL_CRON_TELEGRAM_CHANNELS=""
JOB_EXPIRE_DAYS=14
JOB_EXPIRE_CHECK_SEC=3600

# Источники для парсинга: kwork, flru, freelancehunt, weblancer, tgchannel (через запятую)
ENABLED_SOURCES=kwork,flru,freelancehunt,weblancer,tgchannel

# Kwork
KWORK_BASE_URL=https://kwork.ru
# URL страницы со списком проектов (по умолчанию KWORK_BASE_URL/projects)
CRAWL_LIST_URL=https://kwork.ru/projects

# FL.ru (активировать: добавить flru в ENABLED_SOURCES)
FLRU_LIST_URL=https://www.fl.ru/projects/

# Freelancehunt (активировать: добавить freelancehunt в ENABLED_SOURCES)
FREELANCEHUNT_LIST_URL=https://freelancehunt.com/projects/

# Weblancer (активировать: добавить weblancer в ENABLED_SOURCES)
WEBLANCER_LIST_URL=https://www.weblancer.net/jobs/

# Telegram-каналы (активировать: добавить tgchannel в ENABLED_SOURCES)
# Список username'ов без @, через запятую.
# Общие: freegolup, pomogator, frilanse, freelance_joob, freelancetaverna
# Дизайн: jun_jobs, designer_ru_work
# Копирайтинг: freelancechoice, copywriter_vacancies
# Другие: chitcom
TELEGRAM_CHANNELS=freegolup,pomogator,frilanse,freelance_joob,freelancetaverna,jun_jobs,designer_ru_work,freelancechoice,copywriter_vacancies,chitcom

# Browser Render Service
BROWSER_SERVICE_URL=http://browser-service:8090

# AI
LLM_PROVIDER=gemini
# Gemini API key — required
# GEMINI_API_KEY=your-gemini-api-key
# Plain ai-service consumer uses Gemini classifier only with explicit opt-in.
# ENABLE_GEMINI_CLASSIFIER=1
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_ACTOR_MODEL=gemini-2.0-flash
# ACTOR_GEMINI_TIMEOUT_SEC=30
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Optional local model directories for bundled sentence-transformers assets.
# EMBEDDING_MODELS_DIR=/opt/models
# RERANK_MODELS_DIR=/opt/models
# Current project `.env` allows local cache / remote download fallback.
EMBEDDING_REQUIRE_LOCAL=0
# RERANK_REQUIRE_LOCAL inherits EMBEDDING_REQUIRE_LOCAL when unset.
# RERANK_REQUIRE_LOCAL=1
# Current project `.env` disables warmup to reduce peak RAM.
AI_WARMUP_ENABLED=0
# AI metrics endpoint (Prometheus text format).
# Set port to 0 to disable exporter in the corresponding process.
AI_METRICS_BIND=0.0.0.0
AI_CONSUMER_METRICS_PORT=9108
AI_AC_CONSUMER_METRICS_PORT=9109
AI_USER_EMBED_METRICS_PORT=9110
# Internal debug-match endpoint used by backend /admin/debug/match proxy.
AI_DEBUG_MATCH_PORT=8093

# Matching
# Порог косинусного сходства для ANN (0.60-0.65 оптимально для all-MiniLM-L6-v2, ниже 0.50 = мусор в кандидатах)
SIMILARITY_THRESHOLD=0.62
# ANN candidate pool before cross-encoder rerank (recommended: 50).
MAX_MATCHES_PER_JOB=50
# Cross-encoder model for rerank stage.
RERANK_MODEL=BAAI/bge-reranker-base
# Мин. cross-encoder score (ниже 0.60 = слабая релевантность)
RERANK_THRESHOLD=0.60
# Number of top reranked candidates kept after cross-encoder filtering.
RERANK_TOP_K=10
# Парсинг профиля через Gemini перед построением embedding.
PROFILE_PARSE_ENABLED=true

# Final batch scoring
AC_BATCH_QUEUE=ac-batch
AI_AC_BATCH_POP_TIMEOUT_SEC=30
AC_BATCH_INTERVAL_SEC=300
AC_BATCH_MIN_JOBS=1
AC_BATCH_MAX_JOBS=20
AC_LEASE_TIMEOUT_SEC=600
AC_PENDING_RETENTION_DAYS=14
AC_PENDING_CLEANUP_INTERVAL_SEC=3600
AC_PENDING_METRICS_REFRESH_SEC=30

# Notifier (Backend consumer match-notify)
MATCH_NOTIFY_QUEUE=match-notify
NOTIFY_RATE_LIMIT_SEC=300
# Preferred per-day notifier cap (legacy fallback: NOTIFY_MAX_PER_DAY).
NOTIFY_PRO_MAX_PER_DAY=5
# Legacy per-day cap key (kept for backward compatibility).
NOTIFY_MAX_PER_DAY=5
NOTIFIER_MAX_RETRIES=3
NOTIFIER_RETRY_BASE_WAIT=1s
NOTIFIER_BREAKER_FAILURE_THRESHOLD=3
NOTIFIER_BREAKER_OPEN_INTERVAL=30s
NOTIFIER_BREAKER_OPEN_JITTER=0.2
NOTIFIER_QUEUE_DEPTH_SAMPLE_PERIOD=60s
NOTIFIER_MATCH_NOTIFY_POP_TIMEOUT=60s

# Telegram (создать бота через @BotFather, токен в .env)
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Optional dev-only override for local polling / notifier smoke without touching the production webhook token.
LOCAL_TELEGRAM_BOT_TOKEN=
# webhook (prod) | polling (local)
BOT_MODE=polling
# polling behavior when the selected token already has an active webhook: standby | ignore
POLLING_ACTIVE_WEBHOOK_POLICY=standby
# https://your-app.up.railway.app/webhook
WEBHOOK_URL=
# openssl rand -hex 32
WEBHOOK_SECRET_TOKEN=
# Telegram webhook parallel connections (1-100)
WEBHOOK_MAX_CONNECTIONS=40
# Telegram bot health/metrics server (0 disables metrics listener)
BOT_METRICS_BIND=0.0.0.0
BOT_METRICS_PORT=9107
# Redis key prefix for durable bot state/idempotency
BOT_REDIS_PREFIX=telegram-bot
LOG_LEVEL=INFO
# Личный chat_id для локальных smoke/e2e-проверок и fallback Alertmanager
TELEGRAM_ID=123456789
# Slack webhook для Alertmanager (опционально)
ALERTMANAGER_SLACK_WEBHOOK_URL=
# Alertmanager can use dedicated vars. Рекомендуется указывать отдельный канал/ops-chat.
ALERTMANAGER_TELEGRAM_BOT_TOKEN=
ALERTMANAGER_TELEGRAM_CHAT_ID=

# API (Backend)
API_AUTH_TOKEN=change_me_long_random_token
API_USER_HMAC_SECRET=change_me_different_long_random_secret
ADMIN_AUTH_TOKEN=change_me_admin_token
ADMIN_TELEGRAM_ID=
API_NONCE_TTL_SEC=600
API_RATE_LIMIT_WINDOW_SEC=60
API_RATE_LIMIT_IP_RPM=120
API_RATE_LIMIT_TG_RPM=60
# By default API fails closed if Redis is unavailable.
# Set to 1 only for explicit temporary degraded mode in development
# (disables nonce/rate-limit/user-embed queue). Forbidden in APP_ENV=production.
API_ALLOW_REDIS_DEGRADED=0
# Comma-separated CIDRs of trusted reverse proxies.
# Forwarded headers are ignored unless RemoteAddr is in this allowlist.
# Example: API_TRUSTED_PROXY_CIDRS=127.0.0.1/32,10.0.0.0/8
API_TRUSTED_PROXY_CIDRS=
API_BIND_IP=127.0.0.1
API_PORT=8080
API_ADDR=:8080
# Startup migration (docker-entrypoint.sh runs all migrations/*.sql on start)
# Default: 1 (enabled). All migrations are idempotent (IF NOT EXISTS).
RUN_MIGRATIONS=1
MIGRATION_RETRY_ATTEMPTS=30
MIGRATION_RETRY_DELAY_SEC=2
# Required in APP_ENV=production for backend API
API_TLS_CERT_FILE=
API_TLS_KEY_FILE=
# Local dev
API_URL=http://localhost:8080
# Production example:
# API_URL=https://api.example.com
USER_EMBED_QUEUE=user-embed
# Optional override for backend -> ai-service debug-match proxy.
AI_DEBUG_MATCH_BASE_URL=http://ai-service:8093
AI_USER_EMBED_POP_TIMEOUT_SEC=60
USER_REMATCH_QUEUE=user-rematch
AI_USER_REMATCH_POP_TIMEOUT_SEC=60
REMATCH_JOBS_DAYS_BACK=7
REMATCH_MAX_JOBS=5
AI_USER_REMATCH_HEALTH_PORT=8092

# Prometheus → backend-api scrape (default: http/8080 for dev; set https/8443 in prod with TLS)
# BACKEND_API_METRICS_TARGET=backend-api:8443
# BACKEND_API_METRICS_SCHEME=https
# BACKEND_API_METRICS_TLS_INSECURE_SKIP_VERIFY=true

# Monitoring (required in production — no defaults)
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me_pgadmin_password
# postgres-exporter DSN (required when monitoring profile is enabled)
# Production example: postgresql://site_parser:strong_password@postgres:5432/site_parser?sslmode=require
POSTGRES_EXPORTER_DATA_SOURCE_NAME=postgresql://site_parser:change_me_strong_postgres_password@postgres:5432/site_parser?sslmode=disable
# Grafana DB password (falls back to POSTGRES_PASSWORD if unset)
# GRAFANA_POSTGRES_PASSWORD=

# Фильтрация нерелевантных заказов в краулере
# CRAWLER_FILTER_ENABLED=true по умолчанию; false — отключить полностью
CRAWLER_FILTER_ENABLED=true
# Список разрешённых категорий через запятую (заменяет встроенный whitelist)
CRAWLER_ALLOWED_CATEGORIES=
# Дополнительные стоп-слова через запятую (добавляются к встроенным)
CRAWLER_BLOCKED_KEYWORDS=
