# PostgreSQL
POSTGRES_USER=site_parser
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=site_parser
DATABASE_URL=postgres://site_parser:your_password_here@localhost:5432/site_parser?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0
AI_QUEUE=ai-process

# Crawler
CRAWL_RATE_SEC=15
KWORK_BASE_URL=https://kwork.ru

# AI
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Matching
SIMILARITY_THRESHOLD=0.7
MAX_NOTIFICATIONS_PER_DAY=5

# Telegram (создать бота через @BotFather)
TELEGRAM_BOT_TOKEN=
