# Production mode
APP_ENV=production

# External PostgreSQL (required: sslmode=require|verify-ca|verify-full)
DATABASE_URL=postgres://site_parser:replace_with_strong_password@db.example.com:5432/site_parser?sslmode=require

# External Redis with TLS (required: rediss:// + password)
REDIS_URL=rediss://default:replace_with_strong_redis_password@redis.example.com:6380/0

# API server (TLS is required in production)
API_BIND_IP=127.0.0.1
API_PORT=8443
API_ADDR=:8443
# Startup migration retry (docker-entrypoint.sh)
MIGRATION_RETRY_ATTEMPTS=30
MIGRATION_RETRY_DELAY_SEC=2
API_TLS_CERT_FILE=/run/secrets/api_tls_cert.pem
API_TLS_KEY_FILE=/run/secrets/api_tls_key.pem
API_TLS_CERT_HOST_PATH=/etc/site-parser/tls/fullchain.pem
API_TLS_KEY_HOST_PATH=/etc/site-parser/tls/privkey.pem
# Runtime HOME for read-only containers (prevents libpq lookup under unwritable /home/app).
HOME=/tmp

# Auth secrets
API_AUTH_TOKEN=replace_with_long_random_token
API_USER_HMAC_SECRET=replace_with_long_random_hmac_secret
ADMIN_AUTH_TOKEN=replace_with_another_long_random_token

# Anti-replay / rate-limit
API_NONCE_TTL_SEC=600
API_RATE_LIMIT_WINDOW_SEC=60
API_RATE_LIMIT_IP_RPM=120
API_RATE_LIMIT_TG_RPM=60

# Telegram
TELEGRAM_BOT_TOKEN=replace_with_real_bot_token
LOG_LEVEL=INFO
TELEGRAM_ID=123456789
# Slack webhook for Alertmanager notifications
ALERTMANAGER_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME
# Optional dedicated Alertmanager vars (fallback to TELEGRAM_BOT_TOKEN/TELEGRAM_ID).
ALERTMANAGER_TELEGRAM_BOT_TOKEN=
ALERTMANAGER_TELEGRAM_CHAT_ID=

# Telegram bot -> backend API URL (must be HTTPS in production)
API_URL=https://api.example.com

# Queues / crawling / matching
AI_QUEUE=ai-process
USER_EMBED_QUEUE=user-embed
MATCH_NOTIFY_QUEUE=match-notify
CRAWL_RATE_SEC=15
CRAWL_CRON=*/10 * * * *
CRAWL_RUN_TIMEOUT=10m

# Источники для парсинга: kwork, flru, freelancehunt (через запятую)
ENABLED_SOURCES=kwork,flru,freelancehunt

# Kwork
KWORK_BASE_URL=https://kwork.ru
CRAWL_LIST_URL=https://kwork.ru/projects

# FL.ru (активировать: добавить flru в ENABLED_SOURCES)
FLRU_LIST_URL=https://www.fl.ru/projects/

# Freelancehunt (активировать: добавить freelancehunt в ENABLED_SOURCES)
FREELANCEHUNT_LIST_URL=https://freelancehunt.com/projects/
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_REQUIRE_LOCAL=1
# Required: external Ollama instance (e.g. http://your-gpu-host:11434).
# There is no ollama container in docker-compose.prod.yml — you must provision
# Ollama separately. Without a reachable URL both consumers exit at startup
# (APP_ENV=production implies OLLAMA_REQUIRED=1 by default).
# To intentionally run without Ollama set OLLAMA_REQUIRED=0 — all requests
# will be handled by rule-based fallback logic with degraded AI quality.
OLLAMA_URL=http://your-ollama-host:11434
OLLAMA_MODEL=llama3.2:3b-instruct-q4_K_M
OLLAMA_TIMEOUT_SEC=30
ACTOR_OLLAMA_MODEL=llama3.2:3b-instruct-q4_K_M
CRITIC_OLLAMA_MODEL=llama3.2:3b-instruct-q4_K_M
ACTOR_OLLAMA_TIMEOUT_SEC=45
CRITIC_OLLAMA_TIMEOUT_SEC=30
# OLLAMA_REQUIRED=0  # uncomment to allow rule-based fallback without fail-fast
SIMILARITY_THRESHOLD=0.7
MAX_MATCHES_PER_JOB=20
AC_BATCH_QUEUE=ac-batch
AC_BATCH_INTERVAL_SEC=300
AC_BATCH_MIN_JOBS=1
AC_BATCH_MAX_JOBS=20
AC_SCORE_THRESHOLD=5.0
AC_MAX_ATTEMPTS=3
AC_MAX_JOBS_PER_SELECTION=5
NOTIFY_RATE_LIMIT_SEC=300
# Preferred per-day notifier cap (legacy fallback: NOTIFY_MAX_PER_DAY).
NOTIFY_PRO_MAX_PER_DAY=5
# Legacy per-day cap key (kept for backward compatibility).
NOTIFY_MAX_PER_DAY=5
NOTIFIER_MAX_RETRIES=3
NOTIFIER_RETRY_BASE_WAIT=1s
NOTIFIER_BREAKER_FAILURE_THRESHOLD=3
NOTIFIER_BREAKER_OPEN_INTERVAL=30s
NOTIFIER_BREAKER_OPEN_JITTER=0.2
NOTIFIER_QUEUE_DEPTH_SAMPLE_PERIOD=10s
