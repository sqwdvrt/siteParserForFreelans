# Production mode
APP_ENV=production

# Published images used by docker compose prod (override with pinned digests in CI/CD).
BACKEND_IMAGE=ghcr.io/example/siteparserforfreelans-backend@sha256:1111111111111111111111111111111111111111111111111111111111111111
BROWSER_SERVICE_IMAGE=ghcr.io/example/siteparserforfreelans-browser-service@sha256:2222222222222222222222222222222222222222222222222222222222222222
TELEGRAM_BOT_IMAGE=ghcr.io/example/siteparserforfreelans-telegram-bot@sha256:3333333333333333333333333333333333333333333333333333333333333333
AI_IMAGE=ghcr.io/example/siteparserforfreelans-ai-runtime@sha256:4444444444444444444444444444444444444444444444444444444444444444

# Self-hosted PostgreSQL in /home/deploy/infra (service name: postgres).
DATABASE_URL=postgres://site_parser:replace_with_strong_password@postgres:5432/site_parser?sslmode=require
# In the current VPS topology migrations use the same self-hosted endpoint.
DATABASE_MIGRATE_URL=postgres://site_parser:replace_with_strong_password@postgres:5432/site_parser?sslmode=require
# Optional Postgres pool tuning; current project env uses these values.
PG_POOL_MAX_CONNS=10
PG_POOL_MIN_CONNS=1
PG_POOL_ACQUIRE_TIMEOUT=15s

# Self-hosted Redis in /home/deploy/infra (service name: redis).
REDIS_URL=rediss://default:replace_with_strong_redis_password@redis:6379/0

# API server (TLS is required in production)
API_BIND_IP=127.0.0.1
API_PORT=8443
API_ADDR=:8443
# Startup migration (docker-entrypoint.sh). Default: 1 (enabled). All migrations are idempotent.
RUN_MIGRATIONS=1
MIGRATION_RETRY_ATTEMPTS=30
MIGRATION_RETRY_DELAY_SEC=2
API_TLS_CERT_FILE=/run/secrets/api_tls_cert.pem
API_TLS_KEY_FILE=/run/secrets/api_tls_key.pem
API_TLS_CERT_HOST_PATH=/etc/letsencrypt/live/api.freematch.ru/fullchain.pem
API_TLS_KEY_HOST_PATH=/etc/letsencrypt/live/api.freematch.ru/privkey.pem
# Runtime HOME for read-only containers (prevents libpq lookup under unwritable /home/app).
HOME=/tmp

# Auth secrets
API_AUTH_TOKEN=replace_with_long_random_token
API_USER_HMAC_SECRET=replace_with_long_random_hmac_secret
ADMIN_AUTH_TOKEN=replace_with_another_long_random_token

# Anti-replay / rate-limit
API_NONCE_TTL_SEC=600
API_RATE_LIMIT_WINDOW_SEC=60
API_RATE_LIMIT_IP_RPM=120
API_RATE_LIMIT_TG_RPM=60

# Telegram
TELEGRAM_BOT_TOKEN=replace_with_real_bot_token
# Leave empty in production; for local dev you can use LOCAL_TELEGRAM_BOT_TOKEN in .env instead.
LOCAL_TELEGRAM_BOT_TOKEN=
LOG_LEVEL=INFO
TELEGRAM_ID=123456789
# Slack webhook for Alertmanager notifications
ALERTMANAGER_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME
# Optional dedicated Alertmanager vars (fallback to TELEGRAM_BOT_TOKEN/TELEGRAM_ID).
ALERTMANAGER_TELEGRAM_BOT_TOKEN=
ALERTMANAGER_TELEGRAM_CHAT_ID=
# Optional dedicated VPS health-report vars. If unset, the report reuses Alertmanager
# Telegram settings first, then TELEGRAM_BOT_TOKEN / TELEGRAM_ID.
VPS_HEALTH_TELEGRAM_BOT_TOKEN=
VPS_HEALTH_TELEGRAM_CHAT_ID=
# Optional pgAdmin profile (localhost-only via SSH tunnel on the VPS host).
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=replace_with_openssl_rand_hex_16
# scripts/backup_vps_cron.sh keeps backup files for 7 days by default.

# Telegram bot mode (webhook required in production; polling is dev-only)
BOT_MODE=webhook
# Host-side loopback publish for reverse proxy -> telegram-bot webhook.
BOT_BIND_IP=127.0.0.1
BOT_PORT=8080
# polling behavior when a token already has an active webhook (ignored in normal production webhook mode)
POLLING_ACTIVE_WEBHOOK_POLICY=standby
# Public HTTPS URL that Telegram will POST updates to.
WEBHOOK_URL=https://api.freematch.ru/webhook
# openssl rand -hex 32
WEBHOOK_SECRET_TOKEN=replace_with_openssl_rand_hex_32
# Parallel connections Telegram opens to the webhook endpoint (1-100)
WEBHOOK_MAX_CONNECTIONS=40
# Prometheus metrics endpoint for the bot
BOT_METRICS_BIND=0.0.0.0
BOT_METRICS_PORT=9107
# Redis key prefix for durable bot state/idempotency
BOT_REDIS_PREFIX=telegram-bot

# Telegram bot -> backend API URL (must be HTTPS in production)
API_URL=https://api.freematch.ru

# Monitoring profile overrides for production topology
BACKEND_API_METRICS_TARGET=backend-api:8443
BACKEND_API_METRICS_SCHEME=https
BACKEND_API_METRICS_TLS_INSECURE_SKIP_VERIFY=true
# Optional: only set this when redis-exporter must use a different Redis endpoint than REDIS_URL.
# If unset, redis-exporter uses REDIS_URL, then falls back to redis://redis:6379.
# REDIS_EXPORTER_REDIS_ADDR=rediss://default:replace_with_strong_redis_password@redis:6379
POSTGRES_EXPORTER_DATA_SOURCE_NAME=postgresql://site_parser:replace_with_strong_password@postgres:5432/site_parser?sslmode=require
GRAFANA_POSTGRES_HOST=postgres
GRAFANA_POSTGRES_PORT=5432
GRAFANA_POSTGRES_PASSWORD=replace_with_strong_password
GRAFANA_POSTGRES_SSLMODE=require
GRAFANA_ADMIN_PASSWORD=replace_with_openssl_rand_hex_16

# Queues / crawling / matching
AI_QUEUE=ai-process
AI_PROCESS_POP_TIMEOUT_SEC=60
USER_EMBED_QUEUE=user-embed
AI_USER_EMBED_POP_TIMEOUT_SEC=60
USER_REMATCH_QUEUE=user-rematch
AI_USER_REMATCH_POP_TIMEOUT_SEC=60
REMATCH_JOBS_DAYS_BACK=7
REMATCH_MAX_JOBS=5
AI_USER_REMATCH_HEALTH_PORT=8092
MATCH_NOTIFY_QUEUE=match-notify
CRAWL_RATE_SEC=15
CRAWL_CRON=*/10 * * * *
CRAWL_RUN_TIMEOUT=10m

# Источники для парсинга: kwork, flru, freelancehunt, weblancer, tgchannel (через запятую)
ENABLED_SOURCES=kwork,flru,freelancehunt

# Kwork
KWORK_BASE_URL=https://kwork.ru
CRAWL_LIST_URL=https://kwork.ru/projects

# FL.ru (активировать: добавить flru в ENABLED_SOURCES)
FLRU_LIST_URL=https://www.fl.ru/projects/

# Freelancehunt (активировать: добавить freelancehunt в ENABLED_SOURCES)
FREELANCEHUNT_LIST_URL=https://freelancehunt.com/projects/

# Weblancer (активировать: добавить weblancer в ENABLED_SOURCES)
WEBLANCER_LIST_URL=https://www.weblancer.net/jobs/

# Telegram-каналы (активировать: добавить tgchannel в ENABLED_SOURCES)
# Укажите username'ы публичных каналов через запятую (без @)
# TELEGRAM_CHANNELS=channel1,channel2,channel3
# Browser Render Service
BROWSER_SERVICE_SECRET=replace_with_openssl_rand_hex_32
BROWSER_TIMEOUT_MS=60000

EMBEDDING_MODEL=all-MiniLM-L6-v2
# Optional local model directories for bundled sentence-transformers assets.
# EMBEDDING_MODELS_DIR=/opt/models
# RERANK_MODELS_DIR=/opt/models
# Current project `.env` allows local cache / remote download fallback.
EMBEDDING_REQUIRE_LOCAL=0
# RERANK_REQUIRE_LOCAL inherits EMBEDDING_REQUIRE_LOCAL when unset.
# RERANK_REQUIRE_LOCAL=1
# Current project `.env` disables warmup to reduce peak RAM.
AI_WARMUP_ENABLED=0
AI_METRICS_BIND=0.0.0.0
AI_CONSUMER_METRICS_PORT=9108
AI_AC_CONSUMER_METRICS_PORT=9109
AI_USER_EMBED_METRICS_PORT=9110

LLM_PROVIDER=gemini
# Gemini Flash — fast, cheap, multilingual. No infra to maintain.
GEMINI_API_KEY=replace_with_gemini_api_key
# Plain ai-service consumer keeps classifier disabled unless explicitly enabled:
# ENABLE_GEMINI_CLASSIFIER=1
GEMINI_MODEL=gemini-2.0-flash
# Optional per-role model overrides:
# GEMINI_ACTOR_MODEL=gemini-2.0-flash
# ACTOR_GEMINI_TIMEOUT_SEC=30

# Current tuned threshold in project `.env`.
SIMILARITY_THRESHOLD=0.35
# ANN candidate pool before cross-encoder rerank (recommended: 50).
MAX_MATCHES_PER_JOB=50
# Cross-encoder model for rerank stage.
RERANK_MODEL=BAAI/bge-reranker-base
# Minimum cross-encoder rerank score required for downstream scoring / notification.
RERANK_THRESHOLD=0.55
# Number of top reranked candidates kept after cross-encoder filtering.
RERANK_TOP_K=10
# Keep pre-rerank ranking as a fallback path when rerank produces no qualifying results.
RERANK_FALLBACK_ENABLED=1
AC_BATCH_QUEUE=ac-batch
AI_AC_BATCH_POP_TIMEOUT_SEC=30
AC_BATCH_INTERVAL_SEC=300
AC_BATCH_MIN_JOBS=1
AC_BATCH_MAX_JOBS=20
AC_LEASE_TIMEOUT_SEC=600
AC_PENDING_RETENTION_DAYS=14
AC_PENDING_CLEANUP_INTERVAL_SEC=3600
AC_PENDING_METRICS_REFRESH_SEC=30
NOTIFY_RATE_LIMIT_SEC=300
# Накопительный дайджест для free-пользователей: cron-спецификация интервала отправки (по умолч. каждые 10 мин).
ACCUMULATION_CRON=*/10 * * * *
# Preferred per-day notifier cap (legacy fallback: NOTIFY_MAX_PER_DAY).
NOTIFY_PRO_MAX_PER_DAY=5
# Legacy per-day cap key (kept for backward compatibility).
NOTIFY_MAX_PER_DAY=5
NOTIFIER_MAX_RETRIES=3
NOTIFIER_RETRY_BASE_WAIT=1s
NOTIFIER_BREAKER_FAILURE_THRESHOLD=3
NOTIFIER_BREAKER_OPEN_INTERVAL=30s
NOTIFIER_BREAKER_OPEN_JITTER=0.2
NOTIFIER_QUEUE_DEPTH_SAMPLE_PERIOD=60s
NOTIFIER_MATCH_NOTIFY_POP_TIMEOUT=60s

# Resource limits (docker-compose.prod.yml deploy.resources).
# Tune for your VPS. On a 2 GB VPS use the values below; on 4+ GB you can raise AI_MEM_LIMIT.
API_MEM_LIMIT=512m
BROWSER_MEM_LIMIT=512m
CRAWLER_MEM_LIMIT=512m
NOTIFIER_MEM_LIMIT=256m
BOT_MEM_LIMIT=256m
# Each AI service loads the embedding model independently (~400–600 MB).
# 768m is the safe floor on a 2 GB VPS; raise to 1g on 4 GB hosts.
AI_MEM_LIMIT=768m
# Monitoring stack — reduce on memory-constrained hosts.
PROMETHEUS_MEM_LIMIT=384m
GRAFANA_MEM_LIMIT=256m
